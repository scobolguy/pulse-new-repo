IDENTIFICATION DIVISION.
PROGRAM-ID. INVENTORY-SERVER.
PULSE SERVICE inventory-service.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY PULSE-INVENTORY-CONFIG.
01 REQUEST-TEXT PIC X(129).
01 REPLY-TEXT PIC X(96).
01 RESPONSE-TEXT PIC X(1024).
01 EVENT-TEXT PIC X(1024).
01 QUERY-TEXT PIC X(2048).
01 SNAPSHOT-TEXT PIC X(512).
01 CANONICAL-TEXT PIC X(256).
01 WORDS-TEXT PIC X(256).
01 WORD-TEXT PIC X(128).
01 WORD-BYTES PIC X(256).
01 COMMAND-BYTES PIC X(258).
01 CHECK-BYTES PIC X(256).
01 QUERY-BYTES PIC X(4096).
01 FRAME-BYTES PIC X(4096).
01 REQUEST-ID PIC X(96).
01 INVENTORY-TOKEN PIC X(96).
01 OPERATION-TEXT PIC X(16).
01 ITEM-TEXT PIC X(16).
01 RESERVATION-TEXT PIC X(16).
01 RESERVATION-SKU PIC X(16).
01 SKU-TEXT PIC X(16).
01 AMOUNT-TEXT PIC X(128).
01 KEY-TEXT PIC X(128).
01 NUMBER-JSON PIC X(32).
01 NUMBER-TEXT PIC X(16).
01 AVAILABLE-TEXT PIC X(16).
01 RESERVED-TEXT PIC X(16).
01 QUANTITY-TEXT PIC X(16).
01 ERROR-TEXT PIC X(128).
01 BYTE-COUNT PIC S9(9) COMP-5.
01 WORD-COUNT PIC S9(9) COMP-5.
01 WORD-LENGTH PIC S9(9) COMP-5.
01 BYTE-INDEX PIC S9(9) COMP-5.
01 KEY-INDEX PIC S9(9) COMP-5.
01 KEY-LENGTH PIC S9(9) COMP-5.
01 KEY-VALID PIC S9(9) COMP-5.
01 CHARACTER-CODE PIC S9(9) COMP-5.
01 AMOUNT-VALUE PIC S9(9) COMP-5.
01 AVAILABLE-VALUE PIC S9(9) COMP-5.
01 TOTAL-VALUE PIC S9(9) COMP-5.
01 SAVED-QUANTITY PIC S9(9) COMP-5.
01 RELEASED-VALUE PIC S9(9) COMP-5.
01 WRITE-ROW PIC S9(9) COMP-5.
01 NUMBER-VALUE PIC S9(9) COMP-5.
01 FRAME-LENGTH PIC S9(9) COMP-5.
01 FRAME-HIGH PIC S9(9) COMP-5.
01 FRAME-LOW PIC S9(9) COMP-5.
01 BUFFER-HANDLE PIC S9(9) COMP-5.
01 STATUS-CODE PIC S9(9) COMP-5.
01 HAS-REPLY PIC S9(9) COMP-5.
PROCEDURE DIVISION.
    PERFORM HANDLE-REQUEST
    STOP RUN.

HANDLE-REQUEST.
    PULSE RECEIVE INTO REQUEST-TEXT
    CALL "host.bytes_from_text" USING REQUEST-TEXT
        RETURNING COMMAND-BYTES
    CALL "host.bytes_length" USING COMMAND-BYTES RETURNING BYTE-COUNT
    MOVE 400 TO STATUS-CODE
    IF BYTE-COUNT > 128
        MOVE "Inventory command exceeds 128 bytes" TO ERROR-TEXT
        PERFORM FAIL-REQUEST
    END-IF
    MOVE "{}" TO WORDS-TEXT
    MOVE SPACES TO WORD-BYTES
    MOVE 0 TO WORD-COUNT
    PERFORM VARYING BYTE-INDEX FROM 0 BY 1
        UNTIL BYTE-INDEX > BYTE-COUNT
        MOVE 32 TO CHARACTER-CODE
        IF BYTE-INDEX < BYTE-COUNT
            CALL "host.bytes_get" USING COMMAND-BYTES BYTE-INDEX
                RETURNING CHARACTER-CODE
        END-IF
        IF CHARACTER-CODE < 32 OR CHARACTER-CODE > 126
            MOVE "Inventory command must be printable ASCII"
                TO ERROR-TEXT
            PERFORM FAIL-REQUEST
        END-IF
        IF CHARACTER-CODE = 32
            CALL "host.bytes_length" USING WORD-BYTES
                RETURNING WORD-LENGTH
            IF WORD-LENGTH > 0
                IF WORD-COUNT = 4
                    MOVE "Too many inventory command arguments"
                        TO ERROR-TEXT
                    PERFORM FAIL-REQUEST
                END-IF
                CALL "host.bytes_text" USING WORD-BYTES
                    RETURNING WORD-TEXT
                MOVE WORD-COUNT TO NUMBER-VALUE
                PERFORM FORMAT-NUMBER
                CALL "host.json_set" USING WORDS-TEXT NUMBER-TEXT
                    WORD-TEXT RETURNING WORDS-TEXT
                ADD 1 TO WORD-COUNT
                MOVE SPACES TO WORD-BYTES
            END-IF
        ELSE
            IF CHARACTER-CODE >= 97 AND CHARACTER-CODE <= 122
                SUBTRACT 32 FROM CHARACTER-CODE
            END-IF
            CALL "host.bytes_append" USING WORD-BYTES CHARACTER-CODE
                RETURNING WORD-BYTES
        END-IF
    END-PERFORM
    IF WORD-COUNT NOT = 2 AND WORD-COUNT NOT = 4
        MOVE "Use INQUIRE sku, RESERVE sku quantity reservation-id, or RELEASE reservation-id"
            TO ERROR-TEXT
        PERFORM FAIL-REQUEST
    END-IF
    CALL "host.json_text" USING WORDS-TEXT "0" RETURNING WORD-TEXT
    MOVE WORD-TEXT TO OPERATION-TEXT
    CALL "host.json_text" USING WORDS-TEXT "1" RETURNING KEY-TEXT
    PERFORM VALIDATE-KEY
    IF KEY-VALID = 0
        MOVE "Invalid inventory identifier" TO ERROR-TEXT
        PERFORM FAIL-REQUEST
    END-IF
    MOVE KEY-TEXT TO ITEM-TEXT
    MOVE SPACES TO RESERVATION-TEXT
    MOVE 0 TO AMOUNT-VALUE
    CALL "host.json_set" USING "{}" "operation" OPERATION-TEXT
        RETURNING CANONICAL-TEXT
    EVALUATE TRUE
        WHEN OPERATION-TEXT = "RELEASE" AND WORD-COUNT = 2
            MOVE ITEM-TEXT TO RESERVATION-TEXT
            MOVE SPACES TO ITEM-TEXT
            CALL "host.json_set" USING CANONICAL-TEXT "reservation"
                RESERVATION-TEXT RETURNING CANONICAL-TEXT
        WHEN OPERATION-TEXT = "INQUIRE" AND WORD-COUNT = 2
            CALL "host.json_set" USING CANONICAL-TEXT "item" ITEM-TEXT
                RETURNING CANONICAL-TEXT
        WHEN OPERATION-TEXT = "RESERVE" AND WORD-COUNT = 4
            PERFORM VALIDATE-RESERVATION
        WHEN OTHER
            MOVE "Unknown inventory command or argument count"
                TO ERROR-TEXT
            PERFORM FAIL-REQUEST
    END-EVALUATE
    CALL "host.event_body" RETURNING EVENT-TEXT
    CALL "host.json_text" USING EVENT-TEXT "requestId"
        RETURNING REQUEST-ID
    CALL "host.json_text" USING EVENT-TEXT "inventoryToken"
        RETURNING INVENTORY-TOKEN
    CALL "host.json_set" USING '{"action":"read"}' "canonical"
        CANONICAL-TEXT RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "item" ITEM-TEXT
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "reservation" RESERVATION-TEXT
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "requestId" REQUEST-ID
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "inventoryToken" INVENTORY-TOKEN
        RETURNING QUERY-TEXT
    PERFORM EXCHANGE-DATABASE
    PERFORM CHECK-RESPONSE
    CALL "host.json_has" USING RESPONSE-TEXT "reply" RETURNING HAS-REPLY
    IF HAS-REPLY NOT = 0
        PERFORM FINISH-REPLY
    END-IF
    CALL "host.json_text" USING RESPONSE-TEXT "snapshot"
        RETURNING SNAPSHOT-TEXT
    CALL "host.json_text" USING SNAPSHOT-TEXT "sku" RETURNING SKU-TEXT
    CALL "host.json_text" USING SNAPSHOT-TEXT "reservationSku"
        RETURNING RESERVATION-SKU
    CALL "host.json_integer" USING SNAPSHOT-TEXT "available"
        RETURNING AVAILABLE-VALUE
    CALL "host.json_integer" USING SNAPSHOT-TEXT "total"
        RETURNING TOTAL-VALUE
    CALL "host.json_integer" USING SNAPSHOT-TEXT "quantity"
        RETURNING SAVED-QUANTITY
    CALL "host.json_integer" USING SNAPSHOT-TEXT "released"
        RETURNING RELEASED-VALUE
    MOVE 0 TO WRITE-ROW
    PERFORM APPLY-STOCK-RULES
    CALL "host.json_set" USING QUERY-TEXT "action" "commit"
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "snapshot" SNAPSHOT-TEXT
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "available" AVAILABLE-VALUE
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "quantity" SAVED-QUANTITY
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "released" RELEASED-VALUE
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "writeRow" WRITE-ROW
        RETURNING QUERY-TEXT
    CALL "host.json_set" USING QUERY-TEXT "reply" REPLY-TEXT
        RETURNING QUERY-TEXT
    PERFORM EXCHANGE-DATABASE
    PERFORM CHECK-RESPONSE
    PERFORM FINISH-REPLY.

VALIDATE-KEY.
    CALL "host.bytes_from_text" USING KEY-TEXT RETURNING CHECK-BYTES
    CALL "host.bytes_length" USING CHECK-BYTES RETURNING KEY-LENGTH
    MOVE 1 TO KEY-VALID
    IF KEY-LENGTH < 1 OR KEY-LENGTH > 16
        MOVE 0 TO KEY-VALID
    END-IF
    PERFORM VARYING KEY-INDEX FROM 0 BY 1 UNTIL KEY-INDEX >= KEY-LENGTH
        CALL "host.bytes_get" USING CHECK-BYTES KEY-INDEX
            RETURNING CHARACTER-CODE
        IF NOT ((CHARACTER-CODE >= 65 AND CHARACTER-CODE <= 90)
            OR (KEY-INDEX > 0 AND
                ((CHARACTER-CODE >= 48 AND CHARACTER-CODE <= 57)
                 OR CHARACTER-CODE = 45 OR CHARACTER-CODE = 95)))
            MOVE 0 TO KEY-VALID
        END-IF
    END-PERFORM.

VALIDATE-RESERVATION.
    CALL "host.json_text" USING WORDS-TEXT "2" RETURNING AMOUNT-TEXT
    CALL "host.json_text" USING WORDS-TEXT "3" RETURNING KEY-TEXT
    PERFORM VALIDATE-KEY
    MOVE KEY-TEXT TO RESERVATION-TEXT
    CALL "host.bytes_from_text" USING AMOUNT-TEXT RETURNING CHECK-BYTES
    CALL "host.bytes_length" USING CHECK-BYTES RETURNING KEY-LENGTH
    IF KEY-LENGTH < 1 OR KEY-LENGTH > 6 OR KEY-VALID = 0
        MOVE "Invalid reservation or quantity" TO ERROR-TEXT
        PERFORM FAIL-REQUEST
    END-IF
    PERFORM VARYING KEY-INDEX FROM 0 BY 1 UNTIL KEY-INDEX >= KEY-LENGTH
        CALL "host.bytes_get" USING CHECK-BYTES KEY-INDEX
            RETURNING CHARACTER-CODE
        IF CHARACTER-CODE < 48 OR CHARACTER-CODE > 57
            OR (KEY-INDEX = 0 AND CHARACTER-CODE = 48)
            MOVE "Quantity must be 1..999999 without leading zeros"
                TO ERROR-TEXT
            PERFORM FAIL-REQUEST
        END-IF
        COMPUTE AMOUNT-VALUE = AMOUNT-VALUE * 10 + CHARACTER-CODE - 48
    END-PERFORM
    CALL "host.json_set" USING CANONICAL-TEXT "item" ITEM-TEXT
        RETURNING CANONICAL-TEXT
    CALL "host.json_set" USING CANONICAL-TEXT "quantity" AMOUNT-VALUE
        RETURNING CANONICAL-TEXT
    CALL "host.json_set" USING CANONICAL-TEXT "reservation"
        RESERVATION-TEXT RETURNING CANONICAL-TEXT.

APPLY-STOCK-RULES.
    MOVE AVAILABLE-VALUE TO NUMBER-VALUE
    PERFORM FORMAT-NUMBER
    MOVE NUMBER-TEXT TO AVAILABLE-TEXT
    MOVE SPACES TO REPLY-TEXT
    EVALUATE TRUE
        WHEN OPERATION-TEXT = "RELEASE"
            PERFORM RELEASE-STOCK
        WHEN SKU-TEXT = SPACES
            STRING "NOT FOUND sku " DELIMITED BY SIZE
                ITEM-TEXT DELIMITED BY SPACE INTO REPLY-TEXT
            END-STRING
        WHEN OPERATION-TEXT = "INQUIRE"
            COMPUTE NUMBER-VALUE = TOTAL-VALUE - AVAILABLE-VALUE
            PERFORM FORMAT-NUMBER
            MOVE NUMBER-TEXT TO RESERVED-TEXT
            STRING ITEM-TEXT DELIMITED BY SPACE
                " AVAILABLE " DELIMITED BY SIZE
                AVAILABLE-TEXT DELIMITED BY SPACE
                " RESERVED " DELIMITED BY SIZE
                RESERVED-TEXT DELIMITED BY SPACE INTO REPLY-TEXT
            END-STRING
        WHEN RESERVATION-SKU NOT = SPACES
            STRING "CONFLICT reservation " DELIMITED BY SIZE
                RESERVATION-TEXT DELIMITED BY SPACE
                " already exists" DELIMITED BY SIZE INTO REPLY-TEXT
            END-STRING
        WHEN AVAILABLE-VALUE < AMOUNT-VALUE
            STRING "INSUFFICIENT " DELIMITED BY SIZE
                ITEM-TEXT DELIMITED BY SPACE
                " AVAILABLE " DELIMITED BY SIZE
                AVAILABLE-TEXT DELIMITED BY SPACE INTO REPLY-TEXT
            END-STRING
        WHEN OTHER
            SUBTRACT AMOUNT-VALUE FROM AVAILABLE-VALUE
            MOVE AMOUNT-VALUE TO SAVED-QUANTITY
            MOVE 0 TO RELEASED-VALUE
            MOVE 1 TO WRITE-ROW
            MOVE AVAILABLE-VALUE TO NUMBER-VALUE
            PERFORM FORMAT-NUMBER
            MOVE NUMBER-TEXT TO AVAILABLE-TEXT
            MOVE AMOUNT-VALUE TO NUMBER-VALUE
            PERFORM FORMAT-NUMBER
            MOVE NUMBER-TEXT TO QUANTITY-TEXT
            STRING "RESERVED " DELIMITED BY SIZE
                RESERVATION-TEXT DELIMITED BY SPACE
                " " DELIMITED BY SIZE ITEM-TEXT DELIMITED BY SPACE
                " QTY " DELIMITED BY SIZE QUANTITY-TEXT DELIMITED BY SPACE
                " AVAILABLE " DELIMITED BY SIZE
                AVAILABLE-TEXT DELIMITED BY SPACE INTO REPLY-TEXT
            END-STRING
    END-EVALUATE.

RELEASE-STOCK.
    EVALUATE TRUE
        WHEN RESERVATION-SKU = SPACES
            STRING "NOT FOUND reservation " DELIMITED BY SIZE
                RESERVATION-TEXT DELIMITED BY SPACE INTO REPLY-TEXT
            END-STRING
        WHEN RELEASED-VALUE = 1
            STRING "ALREADY RELEASED " DELIMITED BY SIZE
                RESERVATION-TEXT DELIMITED BY SPACE INTO REPLY-TEXT
            END-STRING
        WHEN OTHER
            ADD SAVED-QUANTITY TO AVAILABLE-VALUE
            MOVE 1 TO RELEASED-VALUE WRITE-ROW
            MOVE AVAILABLE-VALUE TO NUMBER-VALUE
            PERFORM FORMAT-NUMBER
            MOVE NUMBER-TEXT TO AVAILABLE-TEXT
            STRING "RELEASED " DELIMITED BY SIZE
                RESERVATION-TEXT DELIMITED BY SPACE
                " " DELIMITED BY SIZE SKU-TEXT DELIMITED BY SPACE
                " AVAILABLE " DELIMITED BY SIZE
                AVAILABLE-TEXT DELIMITED BY SPACE INTO REPLY-TEXT
            END-STRING
    END-EVALUATE.

FORMAT-NUMBER.
    CALL "host.json_set" USING "{}" "n" NUMBER-VALUE
        RETURNING NUMBER-JSON
    CALL "host.json_value" USING NUMBER-JSON "n" RETURNING NUMBER-TEXT.

EXCHANGE-DATABASE.
    CALL "host.bytes_from_text" USING QUERY-TEXT RETURNING QUERY-BYTES
    CALL "host.bytes_length" USING QUERY-BYTES RETURNING FRAME-LENGTH
    COMPUTE FRAME-HIGH = FRAME-LENGTH / 256
    COMPUTE FRAME-LOW = FRAME-LENGTH - FRAME-HIGH * 256
    CALL "host.bytes_append" USING "0000" FRAME-HIGH
        RETURNING FRAME-BYTES
    CALL "host.bytes_append" USING FRAME-BYTES FRAME-LOW
        RETURNING FRAME-BYTES
    CALL "host.bytes_join" USING FRAME-BYTES QUERY-BYTES
        RETURNING FRAME-BYTES
    CALL "host.tcp_exchange_buffer" USING GATEWAY-ADDRESS GATEWAY-PORT
        FRAME-BYTES 4 1500 1024 RETURNING BUFFER-HANDLE
    CALL "host.buffer_text" USING BUFFER-HANDLE RETURNING RESPONSE-TEXT.

CHECK-RESPONSE.
    CALL "host.json_integer" USING RESPONSE-TEXT "status"
        RETURNING STATUS-CODE
    IF STATUS-CODE NOT = 200
        CALL "host.http_status" USING STATUS-CODE
        PERFORM SEND-RESPONSE
    END-IF.

FINISH-REPLY.
    CALL "host.json_text" USING RESPONSE-TEXT "reply" RETURNING REPLY-TEXT
    CALL "host.json_set" USING '{"code":0}' "data" REPLY-TEXT
        RETURNING RESPONSE-TEXT
    PERFORM SEND-RESPONSE.

FAIL-REQUEST.
    CALL "host.json_set" USING "{}" "status" STATUS-CODE
        RETURNING RESPONSE-TEXT
    CALL "host.json_set" USING RESPONSE-TEXT "error" ERROR-TEXT
        RETURNING RESPONSE-TEXT
    CALL "host.http_status" USING STATUS-CODE
    PERFORM SEND-RESPONSE.

SEND-RESPONSE.
    PULSE SEND RESPONSE-TEXT AS JSON.
