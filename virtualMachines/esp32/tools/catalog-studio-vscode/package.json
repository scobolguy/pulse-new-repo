{
  "name": "pulse-catalog-studio-vscode",
  "displayName": "Pulse Studio",
  "description": "VS Code webview entry point for Pulse Studio.",
  "version": "0.0.1",
  "publisher": "pulse-local",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vfl",
        "aliases": [
          "Visual Flow Language",
          "VFL"
        ],
        "extensions": [
          ".vfl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pascalish",
        "aliases": [
          "Pascalish",
          "Pascalish DSL"
        ],
        "extensions": [".pash", ".flow.pas", ".service.pas", ".program.pas", ".daemon.pas"],
        "configuration": "./language-configuration.json",
        "firstLine": "^\\s*(program|service|daemon|class|mapper|router)\\b"
      },
      {
        "id": "pascal",
        "aliases": [
          "Pascal",
          "Standard Pascal"
        ],
        "extensions": [".pas"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pascalish",
        "scopeName": "source.pascalish",
        "path": "./syntaxes/pascalish.tmLanguage.json"
      },
      {
        "language": "pascal",
        "scopeName": "source.pascal",
        "path": "./syntaxes/pascal.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pulseCatalogStudio.open",
        "title": "Pulse: Open Pulse Studio"
      },
      {
        "command": "pulseCatalogStudio.newVfl",
        "title": "Pulse: New Visual Flow Document"
      },
      {
        "command": "pulseCatalogStudio.refreshDataLibrarian",
        "title": "Pulse: Refresh Data Librarian",
        "icon": "$(refresh)"
      },
      {
        "command": "pulseCatalogStudio.openDataMapper",
        "title": "Pulse: Open Data Mapper"
      },
      {
        "command": "pulseCatalogStudio.refreshInfrastructure",
        "title": "Pulse: Refresh Infrastructure Tree",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pulseCatalogStudio.refreshDataLibrarian",
          "when": "view == pulseCatalogStudio.sidebar",
          "group": "navigation"
        },
        {
          "command": "pulseCatalogStudio.refreshInfrastructure",
          "when": "view == pulseCatalogStudio.infrastructure",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "pulseCatalogStudio.vflEditor",
        "displayName": "Visual Flow Language Editor",
        "selector": [
          {
            "filenamePattern": "*.vfl"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Pulse Studio",
      "properties": {
        "pulse.catalogStudio.url": {
          "type": "string",
          "default": "http://localhost:5173/",
          "description": "URL loaded inside the Pulse Studio webview. Point this to the running Vite or deployed frontend."
        },
        "pulse.catalogStudio.apiBase": {
          "type": "string",
          "default": "http://127.0.0.1:4000",
          "description": "Base URL used by the VFL editor to hydrate palette and topology data from the aggregator APIs."
        },
        "pulse.catalogStudio.distributedCacheApiBase": {
          "type": "string",
          "default": "http://127.0.0.1:4310",
          "description": "Distributed device cache URL for the Network (Distributed Cache) infrastructure branch. All confidence levels are displayed."
        },
        "pulse.catalogStudio.defaultVflExtension": {
          "type": "string",
          "default": ".vfl",
          "description": "Default file extension used for Visual Flow Language documents."
        },
        "pulse.catalogStudio.defaultFolder": {
          "type": "string",
          "default": "aggregator/data/visual-flows",
          "description": "Default workspace-relative folder for newly created VFL documents."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pulseCatalogStudio",
          "title": "Pulse Studio",
          "icon": "media/catalog-studio.svg"
        }
      ]
    },
    "views": {
      "pulseCatalogStudio": [
        {
          "id": "pulseCatalogStudio.infrastructure",
          "name": "Infrastructure"
        },
        {
          "id": "pulseCatalogStudio.sidebar",
          "name": "Pulse Studio",
          "type": "tree"
        }
      ]
    }
  }
}