{
  "name": "pulse-pmachine-debugger",
  "displayName": "Pulse Studio & PMachine Debugger",
  "description": "Editors for Pascalish, COBOLish, VBish, C#, MNF FORTRAN, WFL, MAPL and VFL, with Pulse Studio and PMachine Run/Debug.",
  "repository": {
    "type": "git",
    "url": "https://github.com/scobolguy/pulse-new-repo.git",
    "directory": "virtualMachines/esp32/extensions/pulse-pmachine-debugger"
  },
  "version": "0.1.22",
  "publisher": "pulse",
  "icon": "src/media/pulse-icon.png",
  "files": [
    "package.json",
    "README.md",
    "src/media/**",
    "language-configuration.json",
    "mnf-language-configuration.json",
    "*-language-configuration.json",
    "media/**",
    "syntaxes/**",
    "out/**"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onDebug",
    "onCommand:pulse-pmachine.runCurrentFile",
    "onCommand:pulse-pmachine.debugCurrentFile",
    "onLanguage:pascalish",
    "onLanguage:pascal",
    "onLanguage:vbish",
    "onLanguage:mnf",
    "onLanguage:csharp",
    "onLanguage:wfl",
    "onLanguage:mapl",
    "onLanguage:pulse-pcode",
    "onLanguage:cobolish",
    "onCommand:pulse-pmachine.showAnimation",
    "onLanguage:vfl"
  ],
  "main": "./out/extension.js",
  "type": "module",
  "contributes": {
    "views": {
      "pulseCatalogStudio": [
        {
          "id": "pulseCatalogStudio.infrastructure",
          "name": "Infrastructure"
        },
        {
          "id": "pulseCatalogStudio.sidebar",
          "name": "Data Librarian",
          "type": "tree",
          "visibility": "visible"
        },
        {
          "id": "pulseCatalogStudio.esp32Librarian",
          "name": "Data Librarian (ESP32)",
          "type": "tree",
          "visibility": "visible"
        },
        {
          "id": "pulseCatalogStudio.dataMapper",
          "name": "Data Mapper",
          "type": "tree",
          "visibility": "visible"
        },
        {
          "id": "pulseCatalogStudio.deploy",
          "name": "Deploy",
          "type": "tree",
          "visibility": "visible"
        },
        {
          "id": "pulseCatalogStudio.nodeInventory",
          "name": "Node Inventory",
          "type": "tree",
          "visibility": "visible"
        }
      ],
      "explorer": [
        {
          "id": "pulse-pmachine.dataLibrarian",
          "name": "Pulse Data Librarian"
        },
        {
          "id": "pulse-pmachine.services",
          "name": "Pulse Services"
        },
        {
          "id": "pulse-pmachine.servers",
          "name": "Pulse Servers"
        }
      ]
    },
    "languages": [
      {
        "id": "mnf",
        "aliases": [
          "Minnesota FORTRAN",
          "MNF"
        ],
        "extensions": [
          ".ftn"
        ],
        "configuration": "./mnf-language-configuration.json"
      },
      {
        "id": "pascalish",
        "aliases": [
          "Pascalish",
          "Pascalish DSL"
        ],
        "extensions": [
          ".pash",
          ".flow.pas",
          ".service.pas",
          ".program.pas",
          ".daemon.pas"
        ],
        "configuration": "./pascal-language-configuration.json",
        "firstLine": "^\\s*(program|service|daemon|class|mapper|router)\\b"
      },
      {
        "id": "pascal",
        "aliases": [
          "Pascal",
          "Standard Pascal"
        ],
        "extensions": [
          ".pas"
        ],
        "configuration": "./pascal-language-configuration.json"
      },
      {
        "id": "vfl",
        "aliases": [
          "Visual Flow Language",
          "VFL"
        ],
        "extensions": [
          ".vfl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "csharp",
        "aliases": [
          "C#",
          "CSharp"
        ],
        "extensions": [
          ".cs"
        ],
        "configuration": "./csharp-language-configuration.json"
      },
      {
        "id": "cobolish",
        "aliases": [
          "COBOLish"
        ],
        "extensions": [
          ".cob",
          ".cobol"
        ],
        "configuration": "./cobolish-language-configuration.json"
      },
      {
        "id": "vbish",
        "aliases": [
          "VBish"
        ],
        "extensions": [
          ".bas",
          ".vb",
          ".vbs"
        ],
        "configuration": "./vbish-language-configuration.json"
      },
      {
        "id": "wfl",
        "aliases": [
          "Work Flow Language"
        ],
        "extensions": [
          ".wfl"
        ],
        "configuration": "./dsl-language-configuration.json"
      },
      {
        "id": "mapl",
        "aliases": [
          "MAPL"
        ],
        "extensions": [
          ".mapl"
        ],
        "configuration": "./dsl-language-configuration.json"
      },
      {
        "id": "pulse-pcode",
        "aliases": [
          "PMachine P-code"
        ],
        "extensions": [
          ".pcode"
        ],
        "configuration": "./pcode-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "csharp",
        "scopeName": "source.cs",
        "path": "./syntaxes/csharp.tmLanguage.json"
      },
      {
        "language": "cobolish",
        "scopeName": "source.cobolish",
        "path": "./syntaxes/cobolish.tmLanguage.json"
      },
      {
        "language": "vbish",
        "scopeName": "source.vbish",
        "path": "./syntaxes/vbish.tmLanguage.json"
      },
      {
        "language": "wfl",
        "scopeName": "source.wfl",
        "path": "./syntaxes/wfl.tmLanguage.json"
      },
      {
        "language": "mapl",
        "scopeName": "source.mapl",
        "path": "./syntaxes/mapl.tmLanguage.json"
      },
      {
        "language": "vfl",
        "scopeName": "source.vfl",
        "path": "./syntaxes/vfl.tmLanguage.json"
      },
      {
        "language": "mnf",
        "scopeName": "source.mnf",
        "path": "./syntaxes/mnf.tmLanguage.json"
      },
      {
        "language": "pascalish",
        "scopeName": "source.pascalish",
        "path": "./syntaxes/pascalish.tmLanguage.json"
      },
      {
        "language": "pascal",
        "scopeName": "source.pascal",
        "path": "./syntaxes/pascal.tmLanguage.json"
      },
      {
        "language": "pulse-pcode",
        "scopeName": "source.pulse-pcode",
        "path": "./syntaxes/pcode.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pulse-pmachine.newLanguageDocument",
        "title": "Pulse: New Language Document"
      },
      {
        "command": "pulseCatalogStudio.openIssues",
        "title": "Pulse: Open Issue Board"
      },
      {
        "command": "pulseCatalogStudio.deployNetworkCache",
        "title": "Pulse: Deploy Network Cache"
      },
      {
        "command": "pulseCatalogStudio.open",
        "title": "Pulse: Open Pulse Studio"
      },
      {
        "command": "pulseCatalogStudio.newVfl",
        "title": "Pulse: New Visual Flow Document"
      },
      {
        "command": "pulseCatalogStudio.newWfl",
        "title": "Pulse: New WFL Deployment"
      },
      {
        "command": "pulseCatalogStudio.openWflEditor",
        "title": "Pulse: Open WFL Deployment Editor"
      },
      {
        "command": "pulseCatalogStudio.openFlowDesigner",
        "title": "Pulse: Open in Flow Designer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "pulseCatalogStudio.refreshDataLibrarian",
        "title": "Pulse: Refresh Data Librarian",
        "icon": "$(refresh)"
      },
      {
        "command": "pulseCatalogStudio.openDataMapper",
        "title": "Pulse: Open Data Mapper"
      },
      {
        "command": "pulseCatalogStudio.refreshDataMapper",
        "title": "Pulse: Refresh Data Mapper",
        "icon": "$(refresh)"
      },
      {
        "command": "pulseCatalogStudio.refreshInfrastructure",
        "title": "Pulse: Refresh Infrastructure Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "pulseCatalogStudio.refreshNodeInventory",
        "title": "Pulse: Refresh Node Inventory",
        "icon": "$(refresh)"
      },
      {
        "command": "pulseCatalogStudio.refreshDeployView",
        "title": "Pulse: Refresh Deploy View",
        "icon": "$(refresh)"
      },
      {
        "command": "pulseCatalogStudio.validateWflDeployment",
        "title": "Pulse: Validate WFL Deployment"
      },
      {
        "command": "pulseCatalogStudio.previewWflDeployment",
        "title": "Pulse: Preview WFL Deployment"
      },
      {
        "command": "pulseCatalogStudio.deployWflDeployment",
        "title": "Pulse: Deploy WFL Deployment"
      },
      {
        "command": "pulseCatalogStudio.inspectNode",
        "title": "Pulse: Inspect Node"
      },
      {
        "command": "pulseCatalogStudio.refreshNode",
        "title": "Pulse: Refresh Node"
      },
      {
        "command": "pulseCatalogStudio.unregisterNamedService",
        "title": "Pulse: Unregister Named Service"
      },
      {
        "command": "pulseCatalogStudio.stopHostedContext",
        "title": "Pulse: Stop Hosted Context"
      },
      {
        "command": "pulse-pmachine.showDataLibrarian",
        "title": "Pulse Data Librarian: Browse Schemas"
      },
      {
        "command": "pulse-pmachine.refreshEsp32Librarian",
        "title": "Pulse: Refresh ESP32 Data Librarian",
        "icon": "$(refresh)"
      },
      {
        "command": "pulse-pmachine.openEsp32LibrarianSchema",
        "title": "Pulse: Open ESP32 Schema Metadata"
      },
      {
        "command": "pulse-pmachine.refreshLibrarian",
        "title": "Pulse Data Librarian: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pulse-pmachine.openLibrarianSchema",
        "title": "Pulse Data Librarian: Open Schema Details",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pulse-pmachine.newDataMap",
        "title": "Pulse Data Mapper: Create Prototype MAPL Map"
      },
      {
        "command": "pulse-pmachine.openDataMap",
        "title": "Pulse Data Mapper: Open MAPL in Designer"
      },
      {
        "command": "pulse-pmachine.createDataMap",
        "title": "Pulse Data Mapper: Create MAPL Map"
      },
      {
        "command": "pulse-pmachine.importDataMap",
        "title": "Pulse Data Mapper: Import from Aggregator as MAPL"
      },
      {
        "command": "pulse-pmachine.runCurrentFile",
        "title": "Run on PMachine",
        "icon": "$(play)"
      },
      {
        "command": "pulse-pmachine.debugCurrentFile",
        "title": "Debug on PMachine",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pulse-pmachine.selectDefaultNode",
        "title": "Pulse PMachine: Select Default Node"
      },
      {
        "command": "pulse-pmachine.resetDefaultNode",
        "title": "Pulse PMachine: Reset Default Node"
      },
      {
        "command": "pulse-pmachine.showAnimation",
        "title": "Pulse PMachine: Show Hanoi Animation"
      },
      {
        "command": "pulse-pmachine.refreshServices",
        "title": "Pulse Services: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pulse-pmachine.refreshServers",
        "title": "Pulse Servers: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pulse-pmachine.openServiceEndpoint",
        "title": "Pulse Services: Open Endpoint",
        "icon": "$(link-external)"
      }
    ],
    "customEditors": [
      {
        "viewType": "pulseCatalogStudio.wflDeploymentEditor",
        "displayName": "WFL Configuration and Deployment",
        "selector": [
          {
            "filenamePattern": "*.wfl"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "pulseCatalogStudio.vflEditor",
        "displayName": "Visual Flow Language Editor",
        "selector": [
          {
            "filenamePattern": "*.vfl"
          }
        ],
        "workbench.editorAssociations": [
          {
            "viewType": "pulseCatalogStudio.vflEditor",
            "filenamePattern": "*.vfl"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "pulseCatalogStudio.wflFlowEditor",
        "displayName": "WFL Flow Designer",
        "selector": [
          {
            "filenamePattern": "*.wfl"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "pulse-pmachine.dataMapper",
        "displayName": "Pulse Data Mapper",
        "selector": [
          {
            "filenamePattern": "*.mapl"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pulseCatalogStudio.refreshDataLibrarian",
          "when": "view == pulseCatalogStudio.sidebar",
          "group": "navigation"
        },
        {
          "command": "pulseCatalogStudio.refreshInfrastructure",
          "when": "view == pulseCatalogStudio.infrastructure",
          "group": "navigation"
        },
        {
          "command": "pulseCatalogStudio.refreshDataMapper",
          "when": "view == pulseCatalogStudio.dataMapper",
          "group": "navigation"
        },
        {
          "command": "pulseCatalogStudio.refreshNodeInventory",
          "when": "view == pulseCatalogStudio.nodeInventory",
          "group": "navigation"
        },
        {
          "command": "pulseCatalogStudio.refreshDeployView",
          "when": "view == pulseCatalogStudio.deploy",
          "group": "navigation"
        },
        {
          "command": "pulse-pmachine.refreshEsp32Librarian",
          "when": "view == pulseCatalogStudio.esp32Librarian",
          "group": "navigation"
        },
        {
          "command": "pulse-pmachine.refreshLibrarian",
          "when": "view == pulse-pmachine.dataLibrarian",
          "group": "navigation"
        },
        {
          "command": "pulse-pmachine.refreshServices",
          "when": "view == pulse-pmachine.services",
          "group": "navigation"
        },
        {
          "command": "pulse-pmachine.refreshServers",
          "when": "view == pulse-pmachine.servers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pulseCatalogStudio.deployNetworkCache",
          "when": "view == pulseCatalogStudio.deploy && viewItem == network-cache-deployment",
          "group": "1_manage"
        },
        {
          "command": "pulseCatalogStudio.validateWflDeployment",
          "when": "view == pulseCatalogStudio.deploy && viewItem == wfl-deployment",
          "group": "1_manage"
        },
        {
          "command": "pulseCatalogStudio.previewWflDeployment",
          "when": "view == pulseCatalogStudio.deploy && viewItem == wfl-deployment",
          "group": "1_manage"
        },
        {
          "command": "pulseCatalogStudio.deployWflDeployment",
          "when": "view == pulseCatalogStudio.deploy && viewItem == wfl-deployment",
          "group": "1_manage"
        },
        {
          "command": "pulseCatalogStudio.inspectNode",
          "when": "view == pulseCatalogStudio.nodeInventory && viewItem == inventory-node",
          "group": "1_manage"
        },
        {
          "command": "pulseCatalogStudio.refreshNode",
          "when": "view == pulseCatalogStudio.nodeInventory && viewItem == inventory-node",
          "group": "1_manage"
        },
        {
          "command": "pulseCatalogStudio.unregisterNamedService",
          "when": "view == pulseCatalogStudio.nodeInventory && viewItem == inventory-registered-service",
          "group": "1_manage"
        },
        {
          "command": "pulseCatalogStudio.stopHostedContext",
          "when": "view == pulseCatalogStudio.nodeInventory && (viewItem == inventory-hosted-context || viewItem == inventory-daemon)",
          "group": "1_manage"
        },
        {
          "command": "pulse-pmachine.openLibrarianSchema",
          "when": "view == pulse-pmachine.dataLibrarian && viewItem == pulseLibrarianSchema",
          "group": "inline"
        },
        {
          "command": "pulse-pmachine.openLibrarianSchema",
          "when": "(view == pulseCatalogStudio.sidebar || view == pulse-pmachine.dataLibrarian) && viewItem == pulseLibrarianSchema",
          "group": "1_open"
        },
        {
          "command": "pulse-pmachine.openEsp32LibrarianSchema",
          "when": "view == pulseCatalogStudio.esp32Librarian && viewItem == pulseEsp32LibrarianSchema",
          "group": "1_open"
        },
        {
          "command": "pulse-pmachine.openServiceEndpoint",
          "when": "(view == pulse-pmachine.services || view == pulse-pmachine.servers) && viewItem == pulseServiceEndpoint",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "pulseCatalogStudio.openFlowDesigner",
          "when": "editorLangId == vfl",
          "group": "navigation@1"
        },
        {
          "command": "pulseCatalogStudio.openWflEditor",
          "when": "editorLangId == wfl",
          "group": "navigation@1"
        },
        {
          "command": "pulseCatalogStudio.newVfl",
          "when": "editorLangId == vfl",
          "group": "navigation@1"
        },
        {
          "command": "pulseCatalogStudio.openFlowDesigner",
          "when": "editorLangId == wfl",
          "group": "navigation@1"
        },
        {
          "command": "pulse-pmachine.runCurrentFile",
          "when": "editorLangId == csharp || editorLangId == cobolish || editorLangId == mnf || editorLangId == pascalish || editorLangId == pascal || editorLangId == vbish || editorLangId == wfl || editorLangId == mapl || editorLangId == pulse-pcode",
          "group": "navigation@1"
        },
        {
          "command": "pulse-pmachine.debugCurrentFile",
          "when": "editorLangId == csharp || editorLangId == cobolish || editorLangId == mnf || editorLangId == pascalish || editorLangId == pascal || editorLangId == vbish || editorLangId == wfl || editorLangId == mapl || editorLangId == pulse-pcode",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pulseCatalogStudio.open"
        },
        {
          "command": "pulseCatalogStudio.newVfl"
        },
        {
          "command": "pulseCatalogStudio.openFlowDesigner",
          "when": "editorLangId == wfl || editorLangId == vfl"
        },
        {
          "command": "pulse-pmachine.runCurrentFile",
          "when": "editorLangId == csharp || editorLangId == cobolish || editorLangId == mnf || editorLangId == pascalish || editorLangId == pascal || editorLangId == vbish || editorLangId == wfl || editorLangId == mapl || editorLangId == pulse-pcode"
        },
        {
          "command": "pulse-pmachine.debugCurrentFile",
          "when": "editorLangId == csharp || editorLangId == cobolish || editorLangId == mnf || editorLangId == pascalish || editorLangId == pascal || editorLangId == vbish || editorLangId == wfl || editorLangId == mapl || editorLangId == pulse-pcode"
        }
      ]
    },
    "configuration": {
      "title": "Pulse PMachine",
      "properties": {
        "pulse-pmachine.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000",
          "description": "Aggregator backend URL used by Data Librarian, Data Mapper, service discovery, and PMachine programs."
        },
        "pulse-pmachine.wfl.environment": {
          "type": "string",
          "default": "",
          "description": "Environment used when compiling WFL for Run on PMachine and debugging (e.g. dev, test, prod). Empty uses PULSE_ENVIRONMENT, then the file's DEFAULT ENVIRONMENT."
        },
        "pulse-pmachine.nativeInterpreterPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to pulse_native_service_host.exe. Empty builds the C++ interpreter into .pulse-build/native-pmachine when the first P-code debug session starts."
        },
        "pulse-pmachine.wfl.defines": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Name/value pairs that override WFL LET variables when compiling for Run on PMachine and debugging."
        },
        "pulse-pmachine.nodeHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "127.0.0.1:4111",
            "127.0.0.1:4112",
            "127.0.0.1:4113",
            "192.168.2.155"
          ],
          "description": "PMachine node hosts offered by Run on PMachine. host:port entries are JS PMachine nodes; bare IPs are ESP32 boards."
        },
        "pulse-pmachine.showAnimation": {
          "type": "boolean",
          "default": false,
          "description": "Open the Towers of Hanoi animation panel after Run on PMachine."
        },
        "pulse.catalogStudio.url": {
          "type": "string",
          "default": "http://localhost:5173/",
          "description": "URL loaded inside the Pulse Studio webview. Point this to the running Vite or deployed frontend."
        },
        "pulse.catalogStudio.apiBase": {
          "type": "string",
          "default": "http://127.0.0.1:4000",
          "description": "Base URL used for Studio VFL palette and topology data."
        },
        "pulse.catalogStudio.distributedCacheApiBase": {
          "type": "string",
          "default": "http://127.0.0.1:4310",
          "description": "Distributed device cache URL for the Network infrastructure branch."
        },
        "pulse.catalogStudio.mapperApiBase": {
          "type": "string",
          "default": "http://127.0.0.1:4200",
          "description": "Data Mapper service URL used by the Studio mapper sidebar."
        },
        "pulse.catalogStudio.defaultVflExtension": {
          "type": "string",
          "default": ".vfl",
          "description": "Default extension for new visual graphs. .vfl stores executable graphs separately from WFL deployment/configuration; .wfl preserves the embedded FLOW designer."
        },
        "pulse.catalogStudio.defaultFolder": {
          "type": "string",
          "default": "aggregator/data/visual-flows",
          "description": "Workspace-relative folder for new VFL documents."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pulseCatalogStudio",
          "title": "Pulse Studio",
          "icon": "media/catalog-studio.svg"
        }
      ]
    },
    "debuggers": [
      {
        "type": "pulse-pmachine",
        "label": "Pulse PMachine",
        "languages": [
          "pascalish",
          "pascal",
          "cobolish",
          "vbish",
          "mnf",
          "csharp",
          "wfl",
          "pulse-pcode"
        ],
        "configurationAttributes": {
          "activeFile": {
            "type": "boolean",
            "description": "Debug the active editor file using the saved default PMachine node."
          },
          "program": {
            "type": "string",
            "description": "Source file or compiled .pcode file to execute."
          },
          "cobolSourceFormat": {
            "type": "string",
            "enum": [
              "auto",
              "fixed",
              "free"
            ],
            "description": "COBOL source format. Auto recognizes numbered fixed-format cards; use fixed for unnumbered fixed-format source."
          },
          "cobolDataDirectory": {
            "type": "string",
            "description": "Local COBOL debugger ISAM/filesystem storage directory. Defaults to .pulse-debug/cobol-data in the workspace."
          },
          "programMap": {
            "type": "string",
            "description": "P-code program-map sidecar. Defaults to the matching .program.json file beside the .pcode file."
          },
          "requestMethod": {
            "type": "string",
            "description": "HTTP method used to invoke a native hosted-service P-code artifact; defaults to the first service endpoint."
          },
          "requestPath": {
            "type": "string",
            "description": "HTTP path used to invoke a native hosted-service P-code artifact; defaults to the first service endpoint."
          },
          "requestBody": {
            "type": "string",
            "description": "Request body passed to the native hosted-service P-code artifact."
          },
          "nativeInterpreterPath": {
            "type": "string",
            "description": "Optional path to pulse_native_service_host.exe."
          },
          "environment": {
            "type": "string",
            "description": "WFL only: environment name used for configuration IF/LET evaluation (overrides pulse-pmachine.wfl.environment, PULSE_ENVIRONMENT and DEFAULT ENVIRONMENT)."
          },
          "defines": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "WFL only: name/value pairs that override LET variables."
          },
          "breakpointLine": {
            "type": "number",
            "description": "Initial source breakpoint line."
          },
          "animate": {
            "type": "boolean",
            "description": "Step through source statements automatically and print variables after each step."
          },
          "animationDelayMs": {
            "type": "number",
            "description": "Delay between animated source statements."
          },
          "runtime": {
            "type": "string",
            "enum": [
              "js",
              "js-node",
              "esp32",
              "native"
            ],
            "description": "js = in-process JS PMachine, js-node = standalone JS PMachine node (targetHost host:port), esp32 = ESP32 board (targetHost IP), native = local C++ interpreter for .pcode."
          },
          "debugSession": {
            "type": "boolean",
            "description": "Open an interactive debug session on the remote PMachine (implied by animate)."
          },
          "targetHost": {
            "type": "string",
            "description": "PMachine node address: ESP32 IP (e.g. 192.168.2.155) or JS node host:port (e.g. 127.0.0.1:4111)."
          },
          "debugApiUrl": {
            "type": "string",
            "description": "Pulse backend URL (e.g. http://127.0.0.1:4000). When set, deployment and stepping are driven through /api/pmachine/debug/esp32/session instead of talking to the board directly."
          },
          "fileserverUrl": {
            "type": "string",
            "description": "Shared FFS server URL used by the ESP32 runtime."
          },
          "uploadMode": {
            "type": "string",
            "enum": [
              "direct",
              "shared"
            ],
            "description": "ESP32 artifact upload mode. Direct uploads use the board FFS API."
          },
          "inputQueue": {
            "type": "string",
            "description": "Input queue supplied to the PMachine."
          },
          "message": {
            "type": "string",
            "description": "Input message supplied to the PMachine."
          },
          "maxSteps": {
            "type": "number",
            "description": "Maximum PMachine steps for a remote run."
          },
          "showAnimation": {
            "type": "boolean",
            "default": false,
            "description": "Show the Towers of Hanoi animation panel while debugging Hanoi programs."
          }
        },
        "initialConfigurations": [
          {
            "type": "pulse-pmachine",
            "request": "launch",
            "name": "Debug Active File on Default PMachine",
            "activeFile": true
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "csharp"
      },
      {
        "language": "mnf"
      },
      {
        "language": "pascalish"
      },
      {
        "language": "pascal"
      },
      {
        "language": "vbish"
      },
      {
        "language": "cobolish"
      },
      {
        "language": "wfl"
      },
      {
        "language": "pulse-pcode"
      }
    ],
    "configurationDefaults": {
      "[csharp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      },
      "[cobolish]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordWrap": "off",
        "editor.rulers": [
          6,
          7,
          72
        ]
      },
      "[vbish]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[wfl]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[mapl]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[vfl]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[mnf]": {
        "editor.rulers": [
          5,
          6,
          72,
          80
        ],
        "editor.wordWrap": "off",
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.tabSize": 6,
        "editor.autoIndent": "none"
      }
    }
  },
  "scripts": {
    "compile": "node scripts/sync-pulse-studio.mjs && tsc -p ./",
    "test": "npm run compile && node --test test/*.test.mjs test/*.test.cjs",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/vsce": "^4.0.0",
    "vscode-textmate": "^9.2.0",
    "vscode-oniguruma": "^2.0.1",
    "typescript": "^5.7.0"
  }
}
