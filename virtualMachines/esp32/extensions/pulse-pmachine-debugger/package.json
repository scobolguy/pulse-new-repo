{
  "name": "pulse-pmachine-debugger",
  "displayName": "Pulse PMachine Debugger",
  "description": "Run and debug Pulse PMachine programs from VS Code.",
  "version": "0.1.6",
  "publisher": "pulse",
  "icon": "media/pulse-icon.png",
  "files": [
    "package.json",
    "README.md",
    "media/pulse-icon.png",
    "out/**"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onDebug",
    "onCommand:pulse-pmachine.runCurrentFile",
    "onLanguage:pascalish",
    "onLanguage:pascal",
    "onLanguage:vbish",
    "onLanguage:wfl",
    "onLanguage:mapl",
    "onLanguage:cobolish",
    "onLanguage:vbish"
  ],
  "main": "./out/extension.js",
  "type": "module",
  "contributes": {
    "languages": [
      { "id": "pascalish", "aliases": ["Pascalish"], "extensions": [".pas"] },
      { "id": "vbish", "aliases": ["VBish"], "extensions": [".bas", ".vb", ".vbs"] },
      { "id": "wfl", "aliases": ["Work Flow Language"], "extensions": [".wfl"] },
      { "id": "mapl", "aliases": ["MAPL"], "extensions": [".mapl"] }
    ],
    "commands": [
      {
        "command": "pulse-pmachine.runCurrentFile",
        "title": "Run on PMachine",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pulse-pmachine.runCurrentFile",
          "when": "editorLangId == pascalish || editorLangId == pascal || editorLangId == vbish || editorLangId == wfl || editorLangId == mapl",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "pulse-pmachine.runCurrentFile",
          "when": "editorLangId == pascalish || editorLangId == pascal || editorLangId == vbish || editorLangId == wfl || editorLangId == mapl"
        }
      ]
    },
    "configuration": {
      "title": "Pulse PMachine",
      "properties": {
        "pulse-pmachine.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000",
          "description": "Aggregator backend URL used to discover PMachine targets and run programs."
        }
      }
    },
    "debuggers": [
      {
        "type": "pulse-pmachine",
        "label": "Pulse PMachine",
        "languages": [
          "pascalish",
          "cobolish",
          "vbish"
        ],
        "configurationAttributes": {
          "program": {
            "type": "string",
            "description": "Source program to execute."
          },
          "breakpointLine": {
            "type": "number",
            "description": "Initial source breakpoint line."
          },
          "animate": {
            "type": "boolean",
            "description": "Step through source statements automatically and print variables after each step."
          },
          "animationDelayMs": {
            "type": "number",
            "description": "Delay between animated source statements."
          },
          "runtime": {
            "type": "string",
            "enum": ["js", "esp32"],
            "description": "PMachine runtime target."
          },
          "debugSession": {
            "type": "boolean",
            "description": "Use a persistent interactive debug session on the ESP32."
          },
          "targetHost": {
            "type": "string",
            "description": "ESP32 HTTP host when runtime is esp32."
          },
          "debugApiUrl": {
            "type": "string",
            "description": "Pulse backend URL (e.g. http://127.0.0.1:4000). When set, deployment and stepping are driven through /api/pmachine/debug/esp32/session instead of talking to the board directly."
          },
          "fileserverUrl": {
            "type": "string",
            "description": "Shared FFS server URL used by the ESP32 runtime."
          },
          "uploadMode": {
            "type": "string",
            "enum": ["direct", "shared"],
            "description": "ESP32 artifact upload mode. Direct uploads use the board FFS API."
          },
          "inputQueue": {
            "type": "string",
            "description": "Input queue supplied to the PMachine."
          },
          "message": {
            "type": "string",
            "description": "Input message supplied to the PMachine."
          },
          "maxSteps": {
            "type": "number",
            "description": "Maximum PMachine steps for a remote run."
          }
        },
        "initialConfigurations": [
          {
            "type": "pulse-pmachine",
            "request": "launch",
            "name": "Debug Hanoi on JS PMachine",
            "program": "${workspaceFolder}/artifactPrograms/towers-of-hanoi-program.pas",
            "animate": false,
            "animationDelayMs": 1000
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
