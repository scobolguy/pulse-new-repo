{
  "name": "pulse-pmachine-debugger",
  "displayName": "Pulse PMachine Debugger",
  "description": "Run and debug Pulse PMachine programs from VS Code.",
  "version": "0.1.10",
  "publisher": "pulse",
  "icon": "src/media/pulse-icon.png",
  "files": [
    "package.json",
    "README.md",
    "src/media/**",
    "out/**"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onDebug",
    "onCommand:pulse-pmachine.runCurrentFile",
    "onLanguage:pascalish",
    "onLanguage:pascal",
    "onLanguage:vbish",
    "onLanguage:wfl",
    "onLanguage:mapl",
    "onLanguage:cobolish",
    "onCommand:pulse-pmachine.showAnimation"
  ],
  "main": "./out/extension.js",
  "type": "module",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "pulse-pmachine.dataLibrarian",
          "name": "Pulse Data Librarian"
        },
        {
          "id": "pulse-pmachine.services",
          "name": "Pulse Services"
        },
        {
          "id": "pulse-pmachine.servers",
          "name": "Pulse Servers"
        }
      ]
    },
    "languages": [
      {
        "id": "pascalish",
        "aliases": [
          "Pascalish"
        ],
        "extensions": [
          ".pas"
        ]
      },
      {
        "id": "vbish",
        "aliases": [
          "VBish"
        ],
        "extensions": [
          ".bas",
          ".vb",
          ".vbs"
        ]
      },
      {
        "id": "wfl",
        "aliases": [
          "Work Flow Language"
        ],
        "extensions": [
          ".wfl"
        ]
      },
      {
        "id": "mapl",
        "aliases": [
          "MAPL"
        ],
        "extensions": [
          ".mapl"
        ]
      }
    ],
    "commands": [
      {
        "command": "pulse-pmachine.showDataLibrarian",
        "title": "Pulse Data Librarian: Browse Schemas"
      },
      {
        "command": "pulse-pmachine.refreshLibrarian",
        "title": "Pulse Data Librarian: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pulse-pmachine.openLibrarianSchema",
        "title": "Pulse Data Librarian: Open Schema Details",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pulse-pmachine.newDataMap",
        "title": "Pulse Data Mapper: Create Prototype Map"
      },
      {
        "command": "pulse-pmachine.openDataMap",
        "title": "Pulse Data Mapper: Open Designer"
      },
      {
        "command": "pulse-pmachine.createDataMap",
        "title": "Pulse Data Mapper: Create Map"
      },
      {
        "command": "pulse-pmachine.importDataMap",
        "title": "Pulse Data Mapper: Import from Aggregator"
      },
      {
        "command": "pulse-pmachine.runCurrentFile",
        "title": "Run on PMachine",
        "icon": "$(play)"
      },
      {
        "command": "pulse-pmachine.showAnimation",
        "title": "Pulse PMachine: Show Hanoi Animation"
      },
      {
        "command": "pulse-pmachine.refreshServices",
        "title": "Pulse Services: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pulse-pmachine.refreshServers",
        "title": "Pulse Servers: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pulse-pmachine.openServiceEndpoint",
        "title": "Pulse Services: Open Endpoint",
        "icon": "$(link-external)"
      }
    ],
    "customEditors": [
      {
        "viewType": "pulse-pmachine.dataMapper",
        "displayName": "Pulse Data Mapper",
        "selector": [
          { "filenamePattern": "*.pulse-map.json" },
          { "filenamePattern": "*.mapping.json" },
          { "filenamePattern": "*.map" }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pulse-pmachine.refreshLibrarian",
          "when": "view == pulse-pmachine.dataLibrarian",
          "group": "navigation"
        },
        {
          "command": "pulse-pmachine.refreshServices",
          "when": "view == pulse-pmachine.services",
          "group": "navigation"
        },
        {
          "command": "pulse-pmachine.refreshServers",
          "when": "view == pulse-pmachine.servers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pulse-pmachine.openLibrarianSchema",
          "when": "view == pulse-pmachine.dataLibrarian && viewItem == pulseLibrarianSchema",
          "group": "inline"
        },
        {
          "command": "pulse-pmachine.openServiceEndpoint",
          "when": "(view == pulse-pmachine.services || view == pulse-pmachine.servers) && viewItem == pulseServiceEndpoint",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "pulse-pmachine.runCurrentFile",
          "when": "editorLangId == pascalish || editorLangId == pascal || editorLangId == vbish || editorLangId == wfl || editorLangId == mapl",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "pulse-pmachine.runCurrentFile",
          "when": "editorLangId == pascalish || editorLangId == pascal || editorLangId == vbish || editorLangId == wfl || editorLangId == mapl"
        }
      ]
    },
    "configuration": {
      "title": "Pulse PMachine",
      "properties": {
        "pulse-pmachine.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000",
          "description": "Aggregator backend URL used by Data Librarian, Data Mapper, service discovery, and PMachine programs."
        },
        "pulse-pmachine.nodeHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "127.0.0.1:4111",
            "127.0.0.1:4112",
            "127.0.0.1:4113",
            "192.168.2.155"
          ],
          "description": "PMachine node hosts offered by Run on PMachine. host:port entries are JS PMachine nodes; bare IPs are ESP32 boards."
        },
        "pulse-pmachine.showAnimation": {
          "type": "boolean",
          "default": false,
          "description": "Open the Towers of Hanoi animation panel after Run on PMachine."
        }
      }
    },
    "debuggers": [
      {
        "type": "pulse-pmachine",
        "label": "Pulse PMachine",
        "languages": [
          "pascalish",
          "pascal",
          "cobolish",
          "vbish"
        ],
        "configurationAttributes": {
          "program": {
            "type": "string",
            "description": "Source program to execute."
          },
          "breakpointLine": {
            "type": "number",
            "description": "Initial source breakpoint line."
          },
          "animate": {
            "type": "boolean",
            "description": "Step through source statements automatically and print variables after each step."
          },
          "animationDelayMs": {
            "type": "number",
            "description": "Delay between animated source statements."
          },
          "runtime": {
            "type": "string",
            "enum": [
              "js",
              "js-node",
              "esp32"
            ],
            "description": "js = in-process JS PMachine, js-node = standalone JS PMachine node (targetHost host:port), esp32 = ESP32 board (targetHost IP)."
          },
          "debugSession": {
            "type": "boolean",
            "description": "Open an interactive debug session on the remote PMachine (implied by animate)."
          },
          "targetHost": {
            "type": "string",
            "description": "PMachine node address: ESP32 IP (e.g. 192.168.2.155) or JS node host:port (e.g. 127.0.0.1:4111)."
          },
          "debugApiUrl": {
            "type": "string",
            "description": "Pulse backend URL (e.g. http://127.0.0.1:4000). When set, deployment and stepping are driven through /api/pmachine/debug/esp32/session instead of talking to the board directly."
          },
          "fileserverUrl": {
            "type": "string",
            "description": "Shared FFS server URL used by the ESP32 runtime."
          },
          "uploadMode": {
            "type": "string",
            "enum": [
              "direct",
              "shared"
            ],
            "description": "ESP32 artifact upload mode. Direct uploads use the board FFS API."
          },
          "inputQueue": {
            "type": "string",
            "description": "Input queue supplied to the PMachine."
          },
          "message": {
            "type": "string",
            "description": "Input message supplied to the PMachine."
          },
          "maxSteps": {
            "type": "number",
            "description": "Maximum PMachine steps for a remote run."
          },
          "showAnimation": {
            "type": "boolean",
            "default": false,
            "description": "Show the Towers of Hanoi animation panel while debugging Hanoi programs."
          }
        },
        "initialConfigurations": [
          {
            "type": "pulse-pmachine",
            "request": "launch",
            "name": "Debug Hanoi on JS PMachine node",
            "runtime": "js-node",
            "targetHost": "127.0.0.1:4111",
            "debugSession": true,
            "program": "${workspaceFolder}/src/towers-of-hanoi-program.pas"
          },
          {
            "type": "pulse-pmachine",
            "request": "launch",
            "name": "Debug Hanoi on ESP32",
            "runtime": "esp32",
            "targetHost": "192.168.2.155",
            "debugSession": true,
            "program": "${workspaceFolder}/src/towers-of-hanoi-program.pas"
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "pascalish"
      },
      {
        "language": "pascal"
      },
      {
        "language": "vbish"
      },
      {
        "language": "cobolish"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
