{
  "scopeName": "source.pulse-pcode",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#bindings"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pulse-pcode",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.pulse-pcode",
          "match": "^\\s*[A-Za-z_][A-Za-z0-9_.$-]*:"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.control.pulse-pcode",
          "match": "\\b(ADD|AND|CALL_EXT|CALL|CONCAT|EQ|GE|GT|HALT|JMP|JZ|LE|LOAD|LT|MAP_RETURN|MUL|NEQ|NOP|NOT|OR|PUSH_INT|PUSH_STR|RET|STORE|STREQ|STRNEQ|SUB)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pulse-pcode",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pulse-pcode",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "name": "support.function.pulse-pcode",
          "match": "\\bhost\\.[A-Za-z0-9_]+\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pulse-pcode",
          "match": "(?<![A-Za-z0-9_])-?\\b\\d+\\b"
        }
      ]
    }
  }
}
