{
  "name": "Pulse Kotlin",
  "scopeName": "source.kotlin",
  "patterns": [
    { "name": "comment.line.double-slash.kotlin", "match": "//.*$" },
    { "include": "#blockComment" },
    { "name": "string.quoted.triple.kotlin", "begin": "\"\"\"", "end": "\"\"\"" },
    { "name": "string.quoted.double.kotlin", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.kotlin", "match": "\\\\." }] },
    { "name": "string.quoted.single.kotlin", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.kotlin", "match": "\\\\." }] },
    { "name": "keyword.control.kotlin", "match": "\\b(?:fun|val|var|if|else|when|while|do|for|in|break|continue|return|class|object|interface|package|import|is|as|throw|try|catch|finally|typealias|where|by|this|super)\\b" },
    { "name": "storage.type.kotlin", "match": "\\b(?:Int|Byte|Short|Long|Float|Double|Boolean|Char|String|Unit|Any|Nothing)\\b" },
    { "name": "constant.language.kotlin", "match": "\\b(?:true|false|null)\\b" },
    { "name": "entity.name.function.kotlin", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:<[^<>;{}()]+>)?\\s*\\()" },
    { "name": "constant.numeric.kotlin", "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?)[uUlLfF]*\\b" }
  ],
  "repository": {
    "blockComment": { "name": "comment.block.kotlin", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#blockComment" }] }
  }
}
