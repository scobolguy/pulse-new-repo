{
  "name": "Pulse C#",
  "scopeName": "source.cs",
  "patterns": [
    { "name": "comment.line.double-slash.cs", "match": "//.*$" },
    { "name": "comment.block.cs", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.verbatim.cs", "begin": "@\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.cs", "match": "\"\"" }] },
    { "name": "string.quoted.double.cs", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.cs", "match": "\\\\(?:[abfnrtv0'\"\\\\]|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|x[0-9a-fA-F]{1,4})" }] },
    { "name": "string.quoted.single.cs", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.cs", "match": "\\\\." }] },
    { "name": "variable.other.cs", "match": "@[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "keyword.control.cs", "match": "\\b(?:using|namespace|class|struct|interface|enum|public|private|protected|internal|static|abstract|sealed|virtual|override|partial|readonly|const|if|else|for|foreach|while|do|break|continue|return|switch|case|default|try|catch|finally|throw|new|this|base|typeof|sizeof|checked|unchecked|where|in|out|ref|is|as|lock|async|await|yield)\\b" },
    { "name": "storage.type.cs", "match": "\\b(?:void|int|bool|string|char|byte|sbyte|short|ushort|uint|long|ulong|float|double|decimal|object|var|dynamic)\\b" },
    { "name": "constant.language.cs", "match": "\\b(?:true|false|null)\\b" },
    { "name": "support.class.cs", "match": "\\b(?:System|Console)\\b" },
    { "name": "entity.name.function.cs", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:<[^<>;{}()]+>)?\\s*\\()" },
    { "name": "constant.numeric.cs", "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)[uUlLfFdDmM]*\\b" }
  ]
}
