# ==========================================
# OPERATIONAL DATA ROOT (Federated File System)
# ==========================================
# The aggregator uses a federated file system for operational data.
# This is kept separate from code to enable a catalog/manager infrastructure.
# 
# Configure the root directory where queue managers and operational state live:
#   - Queue manager data (qm-primary, qm-secondary)
#   - Transaction state logs
#   - Runtime metrics and journals
#
# Default: c:\dev\pulse-operational-data (Windows)
#          /opt/pulse/operational-data (Linux)
#
PULSE_OPERATIONAL_DATA_ROOT=c:\dev\pulse-operational-data

# ==========================================
# QUEUE PERSISTENCE
# ==========================================
PULSE_QUEUE_PERSISTENCE=true

# Point queue data to operational root
# If not set, defaults to PULSE_OPERATIONAL_DATA_ROOT
PULSE_QUEUE_DATA_ROOT=

# ==========================================
# RUNTIME DATA
# ==========================================
# Path where runtime configurations are read/written
# If not set, defaults to PULSE_QUEUE_DATA_ROOT
PULSE_RUNTIME_DATA_ROOT=

# ==========================================
# HTTP & BROKER CONFIGURATION
# ==========================================
HTTP_PORT=4000
BROKER_SERVICE_URL=http://localhost:4001
BROKER_PROVIDER=legacy

# ==========================================
# MODULAR BACKEND (Optional)
# ==========================================
# Set to 1 to use separate backend services (broker, queue-manager, etc)
# Set to 0 or omit to use unified backend
MODULAR_BACKEND=0

# ==========================================
# NODE DISCOVERY (independent of broker split)
# ==========================================
# local: Aggregator owns UDP discovery and device probes (default).
# remote: Aggregator consumes collector snapshots; no local UDP listener/probes.
PULSE_DISCOVERY_MODE=local
# Required for remote mode. Use reachable HTTP(S) origins, comma-separated.
PULSE_DISCOVERY_COLLECTOR_URLS=
PULSE_DISCOVERY_POLL_INTERVAL_MS=5000
PULSE_DISCOVERY_TIMEOUT_MS=3000
# Standalone collector configuration. Only one listener per host/UDP port.
DISCOVERY_HTTP_PORT=4300
UDP_PORT=4210
# Give each collector a distinct stable ID; default is hostname + HTTP port.
PULSE_DISCOVERY_COLLECTOR_ID=
