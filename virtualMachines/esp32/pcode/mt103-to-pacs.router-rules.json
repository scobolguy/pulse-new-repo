[
  {
    "id": "mt103-to-pacs-service-http",
    "name": "mt103-to-pacs-service-http",
    "serviceId": "mt103-to-pacs-service",
    "enabled": true,
    "inputQueue": "mt103-to-pacs-service.in",
    "description": "",
    "outputs": [
      {
        "queueName": "mt103-to-pacs-service.out",
        "whenRule": "IF upper(httpVerb) = 'POST' THEN output := 1 ELSE output := 0;",
        "transformRule": "output := src;"
      },
      {
        "queueName": "mt103-to-pacs-service.out",
        "whenRule": "IF upper(httpVerb) = 'GET' THEN output := 1 ELSE output := 0;",
        "transformRule": "output := 'mt103-to-pacs-service';"
      }
    ],
    "createdAt": "2026-09-07T20:37:11.070Z",
    "updatedAt": "2026-09-07T20:37:11.070Z"
  },
  {
    "id": "mt103-to-pacs-router",
    "name": "mt103-to-pacs-router",
    "serviceId": "mt103-to-pacs-service",
    "enabled": true,
    "inputQueue": "swift.mt103.parsed",
    "description": "",
    "outputs": [
      {
        "queueName": "tx.pacs.created",
        "whenRule": "IF startswith(upper(src), \"MT103\") THEN output := 1 ELSE output := 0;",
        "transformRule": "output := map(\"mt103-to-pacs\", src);"
      }
    ],
    "createdAt": "2026-09-07T20:37:11.070Z",
    "updatedAt": "2026-09-07T20:37:11.070Z"
  }
