# Route frontend API traffic through HAProxy instead of a single backend.
VITE_API_PROXY_TARGET=http://localhost:4100

# Data Librarian catalog root. Set this to the directory containing data-types.json
# and services/librarian/schemas. The Windows launcher defaults to aggregator/data.
# LIBRARIAN_DATA_ROOT=C:/path/to/pulse-catalog-data

# Optional: client-side gateway failover (comma-separated).
# When set, browser requests to /api, /status, and /services will try each gateway.
# Example for two HAProxy instances on your LAN:
# VITE_API_BASES=http://192.168.2.101:4100,http://192.168.2.102:4100
