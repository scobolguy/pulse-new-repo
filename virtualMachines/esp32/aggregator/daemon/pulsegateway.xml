<service>
	<id>pulsegateway.exe</id>
	<name>PulseGateway</name>
	<description>Pulse Gateway (default) - API gateway: the only externally-reachable service. Proxies to broker/home-automation when running in split mode.</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>--harmony</argument>
	<argument>C:\dev\pulse-new-repo\virtualMachines\esp32\aggregator\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>C:\dev\pulse-new-repo\virtualMachines\esp32\aggregator\backend.mjs</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>PulseGateway wrapper</argument>
	<argument>--grow</argument>
	<argument>0.5</argument>
	<argument>--wait</argument>
	<argument>2</argument>
	<argument>--maxrestarts</argument>
	<argument>10</argument>
	<argument>--abortonerror</argument>
	<argument>n</argument>
	<argument>--stopparentfirst</argument>
	<argument>undefined</argument>
	<logmode>rotate</logmode>
	<stoptimeout>30sec</stoptimeout>
	<env name="PULSE_ENVIRONMENT" value="default"/>
	<env name="HTTP_PORT" value="4000"/>
	<serviceaccount>
		<domain>NEPTUNE</domain>
		<user>LocalSystem</user>
		<password></password>
	</serviceaccount>
	<workingdirectory>C:\dev\pulse-new-repo\virtualMachines\esp32\aggregator</workingdirectory>
</service>