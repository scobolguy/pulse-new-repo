[
  {
    "id": "enqueue-pacs",
    "steps": [
      {
        "id": "enqueue",
        "action": "call_api",
        "apiSymbol": "aggregator",
        "method": "POST",
        "route": "/api/queue/pacs.outbound/enqueue"
      }
    ]
  },
  {
    "id": "pain2-routing",
    "steps": [
      {
        "id": "if-1",
        "action": "if",
        "condition": {
          "field": "message.status",
          "operator": "equals",
          "value": "reject"
        },
        "then": [
          {
            "id": "route-reject",
            "action": "route_queue",
            "queueRef": "pain2RejectQueue"
          },
          {
            "id": "set-reject-state",
            "action": "set_state",
            "key": "transactionState",
            "value": "rejected"
          }
        ],
        "else": [
          {
            "id": "route-accept",
            "action": "route_queue",
            "queueRef": "pain2AcceptedQueue"
          },
          {
            "id": "set-accept-state",
            "action": "set_state",
            "key": "transactionState",
            "value": "accepted"
          }
        ]
      }
    ]
  },
  {
    "id": "gradual-startup",
    "steps": [
      {
        "id": "check-backend-status-initial",
        "action": "check_api",
        "apiSymbol": "aggregator",
        "method": "GET",
        "route": "/status",
        "expectedStatus": 200,
        "retries": 20,
        "everyMs": 1000
      },
      {
        "id": "stabilize-before-runtime-actions",
        "action": "wait",
        "durationMs": 1500
      },
      {
        "id": "bring-database-up",
        "action": "call_api",
        "apiSymbol": "aggregator",
        "method": "POST",
        "route": "/api/runtime/classes/database/actions/up"
      },
      {
        "id": "wait-after-database",
        "action": "wait",
        "durationMs": 2000
      },
      {
        "id": "check-database-registry",
        "action": "check_api",
        "apiSymbol": "aggregator",
        "method": "GET",
        "route": "/api/registry/databases",
        "expectedStatus": 200,
        "retries": 15,
        "everyMs": 1000
      },
      {
        "id": "bring-broker-up",
        "action": "call_api",
        "apiSymbol": "aggregator",
        "method": "POST",
        "route": "/api/runtime/classes/broker/actions/up"
      },
      {
        "id": "wait-after-broker",
        "action": "wait",
        "durationMs": 2000
      },
      {
        "id": "check-broker-state",
        "action": "check_api",
        "apiSymbol": "aggregator",
        "method": "GET",
        "route": "/api/broker/state",
        "expectedStatus": 200,
        "retries": 15,
        "everyMs": 1000
      },
      {
        "id": "bring-gateways-up",
        "action": "call_api",
        "apiSymbol": "aggregator",
        "method": "POST",
        "route": "/api/runtime/classes/gateway/actions/start"
      },
      {
        "id": "wait-after-gateway",
        "action": "wait",
        "durationMs": 2500
      },
      {
        "id": "check-gateways",
        "action": "check_api",
        "apiSymbol": "aggregator",
        "method": "GET",
        "route": "/api/gateways",
        "expectedStatus": 200,
        "retries": 20,
        "everyMs": 1000
      },
      {
        "id": "check-services-registry",
        "action": "check_api",
        "apiSymbol": "aggregator",
        "method": "GET",
        "route": "/api/registry/services",
        "expectedStatus": 200,
        "retries": 20,
        "everyMs": 1000
      },
      {
        "id": "check-lifecycle-dashboard",
        "action": "check_api",
        "apiSymbol": "aggregator",
        "method": "GET",
        "route": "/api/lifecycle/dashboard",
        "expectedStatus": 200,
        "retries": 20,
        "everyMs": 1000
      },
      {
        "id": "check-runtime-metrics",
        "action": "check_api",
        "apiSymbol": "aggregator",
        "method": "GET",
        "route": "/api/metrics/current",
        "expectedStatus": 200,
        "retries": 20,
        "everyMs": 1000
      }
    ]
  }
]
