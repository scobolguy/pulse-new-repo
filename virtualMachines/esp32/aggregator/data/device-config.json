{
  "deviceTypes": {
    "ESP32": {
      "ledPin": 2,
      "alternativePins": [5, 12, 13, 14, 15],
      "controlMethod": "GPIO",
      "voltage": "3.3V",
      "description": "32-bit dual-core microcontroller"
    },
    "ESP8266": {
      "ledPin": 2,
      "alternativePins": [4, 5, 12, 13, 14, 15],
      "controlMethod": "GPIO",
      "voltage": "3.3V",
      "description": "32-bit single-core microcontroller"
    },
    "ESP32-CAM": {
      "ledPin": 4,
      "alternativePins": [12, 13, 14, 15],
      "controlMethod": "GPIO",
      "voltage": "3.3V",
      "description": "32-bit dual-core microcontroller with camera"
    }
  },
  "devices": {},
  "commands": {
    "gpio_set": {
      "endpoint": "/api/device/{device}/gpio/{pin}/set",
      "method": "POST",
      "body": {
        "value": "0 (LOW/OFF) or 1 (HIGH/ON)"
      }
    },
    "gpio_read": {
      "endpoint": "/api/device/{device}/gpio/{pin}/read",
      "method": "GET"
    }
  }
}
