{
  "version": 1,
  "description": "Owner-managed Pulse services. Pascalish orders explicit requested intent and dependencies; client requests never launch processes.",
  "services": [
    {
      "id": "database",
      "serviceId": "pulse-database",
      "name": "SQL Server Database",
      "management": "external",
      "healthUrl": "http://127.0.0.1:4000/api/runtime/infrastructure/database/ready",
      "readinessUrl": "http://127.0.0.1:4000/api/runtime/infrastructure/database/ready",
      "dependencies": []
    },
    {
      "id": "rabbitmq",
      "serviceId": "pulse-rabbitmq",
      "name": "RabbitMQ Message Broker",
      "management": "external",
      "healthUrl": "http://127.0.0.1:4000/api/runtime/infrastructure/rabbitmq/ready",
      "readinessUrl": "http://127.0.0.1:4000/api/runtime/infrastructure/rabbitmq/ready",
      "dependencies": []
    },
    {
      "id": "broker",
      "registryKey": "broker",
      "serviceId": "pulse-broker",
      "name": "Pulse Broker",
      "command": "node",
      "args": ["broker-service.mjs"],
      "cwd": ".",
      "port": 4001,
      "healthUrl": "http://127.0.0.1:4001/health",
      "readinessUrl": "http://127.0.0.1:4001/ready",
      "startPolicy": "on-demand",
      "idleTimeoutMs": 0,
      "dependencies": []
    },
    {
      "id": "queue-manager-primary",
      "serviceId": "pulse-queue-manager",
      "name": "Pulse Queue Manager Primary",
      "command": "node",
      "args": [
        "queue-manager-node.mjs",
        "--aggregator=http://127.0.0.1:4000",
        "--port=4100",
        "--manager-id=qm-local-4100",
        "--node-id=local-qm-4100",
        "--advertise-ip=127.0.0.1"
      ],
      "cwd": ".",
      "port": 4100,
      "healthUrl": "http://127.0.0.1:4100/health",
      "readinessUrl": "http://127.0.0.1:4100/ready",
      "startPolicy": "on-demand",
      "idleTimeoutMs": 0,
      "dependencies": []
    },
    {
      "id": "mapper",
      "registryKey": "mapper",
      "serviceId": "pulse-data-mapper",
      "name": "Pulse Mapper",
      "command": "node",
      "args": ["data-mapper.mjs"],
      "cwd": ".",
      "port": 4200,
      "healthUrl": "http://127.0.0.1:4200/health",
      "readinessUrl": "http://127.0.0.1:4200/ready",
      "startPolicy": "on-demand",
      "idleTimeoutMs": 600000,
      "dependencies": ["librarian"]
    },
    {
      "id": "filesystem",
      "registryKey": "filesystem",
      "serviceId": "pulse-filesystem",
      "name": "Pulse Filesystem",
      "command": "node",
      "args": ["filesystem-service.mjs"],
      "cwd": ".",
      "port": 4302,
      "healthUrl": "http://127.0.0.1:4302/health",
      "readinessUrl": "http://127.0.0.1:4302/ready",
      "startPolicy": "always-on",
      "idleTimeoutMs": 0,
      "dependencies": []
    },
    {
      "id": "librarian",
      "registryKey": "librarian",
      "serviceId": "pulse-data-librarian",
      "name": "Pulse Librarian",
      "command": "node",
      "args": ["data-librarian.mjs"],
      "cwd": ".",
      "port": 4300,
      "healthUrl": "http://127.0.0.1:4300/health",
      "readinessUrl": "http://127.0.0.1:4300/ready",
      "startPolicy": "on-demand",
      "idleTimeoutMs": 600000,
      "dependencies": ["filesystem"]
    },
    {
      "id": "mcp",
      "serviceId": "pulse-local-mcp",
      "name": "Pulse MCP",
      "command": "node",
      "args": ["src/mcp/pulseMcpServer.mjs"],
      "cwd": ".",
      "port": 4011,
      "healthUrl": "http://127.0.0.1:4011/health",
      "readinessUrl": "http://127.0.0.1:4011/ready",
      "startPolicy": "on-demand",
      "dependencies": []
    },
    {
      "id": "frontend",
      "serviceId": "pulse-frontend",
      "name": "Pulse Frontend",
      "command": "node",
      "args": ["node_modules/vite/bin/vite.js", "--host", "0.0.0.0"],
      "cwd": ".",
      "port": 5173,
      "healthUrl": "http://127.0.0.1:5173/health",
      "readinessUrl": "http://127.0.0.1:5173/ready",
      "startPolicy": "manual",
      "idleTimeoutMs": 0,
      "dependencies": []
    }
  ]
}