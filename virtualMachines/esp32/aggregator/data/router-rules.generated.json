[
  {
    "id": "mt103-correspondent-and-lynx-fanout",
    "name": "mt103-correspondent-and-lynx-fanout",
    "serviceId": "aggregator-router-service",
    "enabled": true,
    "inputQueue": "swift.mt103.parsed",
    "description": "One MT103 to correspondent and LYNX flows",
    "outputs": [
      {
        "queueName": "correspondent.pacs008.outbound",
        "whenRule": "BEGIN output := 1; END",
        "transformRule": "BEGIN output := map (\"mt103-to-pacs\", src); END"
      },
      {
        "queueName": "lynx.pacs009.outbound",
        "whenRule": "BEGIN output := 1; END",
        "transformRule": "BEGIN output := map (\"pacs-to-lynx\", map (\"mt103-to-pacs\", src)); END"
      }
    ],
    "createdAt": "2026-05-29T17:26:56.825Z",
    "updatedAt": "2026-05-29T17:26:56.825Z"
  },
  {
    "id": "swift-fanout-default",
    "name": "swift-fanout-default",
    "serviceId": "aggregator-router-service",
    "enabled": true,
    "inputQueue": "swift.inbound",
    "description": "Default fanout by MT type",
    "outputs": [
      {
        "queueName": "audit.all",
        "whenRule": "output := 1;",
        "transformRule": "output := src;"
      },
      {
        "queueName": "payments.mt103",
        "whenRule": "IF startswith(upper(src), \\\"MT103\\\") THEN output := 1 ELSE output := 0;",
        "transformRule": "output := src;"
      },
      {
        "queueName": "payments.mt202",
        "whenRule": "IF startswith(upper(src), \\\"MT202\\\") THEN output := 1 ELSE output := 0;",
        "transformRule": "output := src;"
      }
    ],
