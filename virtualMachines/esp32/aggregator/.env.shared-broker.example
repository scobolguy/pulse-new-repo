# Shared broker configuration for all backend nodes (Neptune, MacBook, etc.)
# Copy to .env.local on each backend host and keep values identical.

BROKER_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://192.168.2.50:5672
RABBITMQ_EXCHANGE=pulse-broker
RABBITMQ_QUEUE_PREFIX=pulse

# Optional but recommended for restart resilience per host.
PULSE_QUEUE_PERSISTENCE=1

# Use a host-local path on each machine.
# Windows example:
# PULSE_QUEUE_DATA_ROOT=C:\\pulse-node-data\\queue-data
# macOS example:
# PULSE_QUEUE_DATA_ROOT=/Users/yourname/pulse-node-data/queue-data
