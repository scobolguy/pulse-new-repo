{
  "name": "aggregator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/startup-fsm-workflow.mjs && node scripts/frontend-startup-fsm-workflow.mjs",
    "dev:raw": "vite",
    "dev:backend": "node --env-file=.env.local backend.mjs",
    "dev:backend:aux": "node --env-file=.env.local --input-type=module -e \"process.env.BACKEND_AUX_SERVICES_AUTOSTART='1'; await import('./backend.mjs')\"",
    "dev:backend:raw": "node backend.mjs",
    "dev:librarian": "node data-librarian.mjs",
    "dev:mapper-service": "node data-mapper.mjs",
    "dev:mcp": "node src/mcp/pulseMcpServer.mjs",
    "service:mcp:install": "node scripts/manage-mcp-windows-service.cjs install",
    "service:mcp:uninstall": "node scripts/manage-mcp-windows-service.cjs uninstall",
    "startup:fsm:backend": "node scripts/startup-fsm-workflow.mjs",
    "startup:fsm:workflow": "node scripts/startup-fsm-workflow.mjs",
    "startup:fsm:frontend": "node scripts/frontend-startup-fsm-workflow.mjs",
    "startup:fsm:all": "node scripts/startup-fsm-workflow.mjs && node scripts/frontend-startup-fsm-workflow.mjs",
    "startup:fsm:ordered": "node scripts/startup-ordered-ready.mjs",
    "deploy:cluster:compose:up": "docker compose -f deploy/cluster/docker-compose.daemons.yml up -d --build",
    "deploy:cluster:compose:down": "docker compose -f deploy/cluster/docker-compose.daemons.yml down",
    "deploy:cluster:k8s:apply": "kubectl apply -f deploy/cluster/k8s-daemons.yaml",
    "deploy:cluster:k8s:delete": "kubectl delete -f deploy/cluster/k8s-daemons.yaml",
    "supervisor:heartbeat:host": "node scripts/supervisor-heartbeat-host.mjs",
    "supervisor:heartbeat:host:once": "node scripts/supervisor-heartbeat-host.mjs --once",
    "dev:frontend:wait-backend": "node scripts/dev-frontend-when-backend.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "compile:dsl": "node scripts/compile-pascal.mjs",
    "compile:pcode": "node scripts/compile-pascal-to-pcode.mjs",
    "compile:pascal:std": "node scripts/compile-standard-pascal-antlr-to-pcode.mjs --in ./data/towers-of-hanoi.pas --out ../pcode/towers-of-hanoi.pcode --map-out ../pcode/towers-of-hanoi.program.json",
    "compile:pascalish:program": "node scripts/compile-pascalish-program-antlr-to-pcode.mjs --in ./data/hello-world.pas --out ../pcode/pascalish-program.pcode --map-out ../pcode/pascalish-program.program.json",
    "compile:mapl": "node scripts/compile-mapl-antlr-to-pcode.mjs --in ./data/sample.mapl --out ../pcode/mapl.pcode --map-out ../pcode/mapl.program.json",
    "pascalishc": "node scripts/pascalishc-antlr-gateway.mjs",
    "proof:hanoi:js-pmachine": "npm run compile:pascal:std && node scripts/run-js-pmachine.mjs --pcode ../pcode/towers-of-hanoi.pcode --program-map ../pcode/towers-of-hanoi.program.json --input-queue hanoi.proof --message \"\"",
    "antlr:generate": "node scripts/generate-antlr-parsers.mjs",
    "lsp:pascalish": "node tools/pascalish-lsp/server.mjs",
    "run:pcode:js": "node scripts/run-js-pmachine.mjs",
    "run:pascal:esp32": "node scripts/run-pascal-on-esp32-node.mjs",
    "compile:workflow": "node scripts/compile-workflow-dsl.mjs --in data/workflow.wfl",
    "compile:workflow:pcode": "node scripts/compile-workflow-to-pcode.mjs --in data/workflow.wfl --workflow pain2-routing --out ../pcode/workflow-router.pcode --out-map ../pcode/workflow-router.program.json",
    "interpret:workflow": "node scripts/interpret-workflow.mjs --in data/workflow.wfl --workflow enqueue-pacs",
    "db:provision:ticketing": "node scripts/provision-ticketing-db.mjs",
    "db:seed:ticketing": "node scripts/seed-ticketing-db-from-json.mjs --json ./data/issue-test-system.json",
    "check:pcode-compat": "node scripts/check-pcode-compat.mjs",
    "compile:lifecycle": "node scripts/compile-transaction-lifecycle-dsl.mjs --in data/transaction-lifecycle.tsl",
    "load:stress-flows": "node stress-flows-load-test.mjs",
    "load:stress-sweep": "node scripts/stress-runtime-sweep.mjs",
    "load:stress-compare": "node scripts/compare-stress-reports.mjs",
    "test:allocator": "node scripts/test-economic-allocator.mjs",
    "test:allocator:e2e:pascalish": "node scripts/test-allocator-e2e-pascalish.mjs",
    "test:smoke:ui": "node scripts/smoke-ui.mjs",
    "test:smoke:pascalish-editor": "node scripts/smoke-pascalish-editor-playwright.mjs http://localhost:5173/",
    "test:developer:esp-run": "node scripts/test-developer-esp-run.mjs http://localhost:5173/",
    "test:developer:esp-run:headless": "node scripts/test-developer-esp-run.mjs http://localhost:5173/ --headless",
    "test:js-pmachine:spec-opcodes": "node scripts/test-js-pmachine-spec-opcodes.mjs",
    "test:pcode-compiler:string-escaping": "node scripts/test-pcode-compiler-string-escaping.mjs",
    "test:pascalish:endpoint-bnf": "node scripts/test-pascalish-endpoint-bnf.mjs",
    "test:mapl:compiler": "node scripts/test-mapl-compiler.mjs",
    "test:librarian:subschemas": "node scripts/test-librarian-subschemas.mjs",
    "test:nli:config": "node scripts/test-nli-config.mjs",
    "test:nli:corrections": "node scripts/test-nli-corrections.mjs",
    "test:bob:corrections-button": "node scripts/test-bob-corrections-button.mjs",
    "test:companion-supervisor": "node scripts/test-companion-service-supervisor.mjs",
    "test:agent:corrections": "node scripts/test-agent-corrections.mjs",
    "test:agent:corrections:e2e": "node scripts/test-agent-corrections-e2e.mjs",
    "test:mcp": "node scripts/test-pulse-mcp.mjs",
    "test:alexa": "node scripts/test-pulse-alexa-skill.mjs",
    "test:js-pmachine:negative-opcodes": "node scripts/test-js-pmachine-negative-opcodes.mjs",
    "test:js-pmachine:failure-paths": "node scripts/test-js-pmachine-failure-paths.mjs",
    "test:smoke:simple": "node scripts/test-simple-smoke-suite.mjs",
    "test:ollama:query:all-nodes": "node scripts/test-openai-query-all-nodes-playwright.mjs http://localhost:5173/",
    "test:ollama:query:all-nodes:headless": "node scripts/test-openai-query-all-nodes-playwright.mjs http://localhost:5173/ --headless",
    "test:bob-console": "node scripts/test-bob-console-playwright.mjs http://127.0.0.1:5173/bob-console.html",
    "dsl:ollama:build-corpus": "node scripts/build-dsl-ollama-corpus.mjs",
    "dsl:ollama:run": "node scripts/run-ollama-dsl-coach.mjs",
    "dsl:ollama:mentor": "node scripts/run-ollama-pascal-mentor-loop.mjs",
    "dsl:ollama:ingest-answer": "node scripts/ingest-pascal-mentor-answer.mjs",
    "deploy:esp32:hello-service": "node scripts/deploy-esp32-helloService.mjs",
    "evolution:first-slice": "node scripts/evolution-first-slice.mjs",
    "evolution:first-slice:manifest": "node scripts/evolution-first-slice.mjs --manifest ../data/evolution-organisms.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "amqplib": "^0.10.4",
    "antlr4": "^4.13.2",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-express-adapter": "^2.14.0",
    "axios": "^1.18.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.8.0",
    "ibmmq": "^2.1.8",
    "kafkajs": "^2.2.4",
    "mermaid": "^11.15.0",
    "msnodesqlv8": "^5.2.0",
    "mssql": "^11.0.1",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "node-windows": "^1.0.0-beta.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "stompit": "^1.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.60.0",
    "vite": "^8.0.10"
  }
}
