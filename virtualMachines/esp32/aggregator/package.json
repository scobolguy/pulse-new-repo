{
  "name": "aggregator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "compile:dsl": "node scripts/compile-pascal.mjs",
    "compile:pcode": "node scripts/compile-pascal-to-pcode.mjs",
    "run:pcode:js": "node scripts/run-js-pmachine.mjs",
    "compile:workflow": "node scripts/compile-workflow-dsl.mjs --in data/workflow.wfl",
    "compile:workflow:pcode": "node scripts/compile-workflow-to-pcode.mjs --in data/workflow.wfl --workflow pain2-routing --out ../pcode/workflow-router.pcode --out-map ../pcode/workflow-router.program.json",
    "interpret:workflow": "node scripts/interpret-workflow.mjs --in data/workflow.wfl --workflow enqueue-pacs",
    "check:pcode-compat": "node scripts/check-pcode-compat.mjs",
    "compile:lifecycle": "node scripts/compile-transaction-lifecycle-dsl.mjs --in data/transaction-lifecycle.tsl",
    "load:stress-flows": "node stress-flows-load-test.mjs",
    "load:stress-sweep": "node scripts/stress-runtime-sweep.mjs",
    "load:stress-compare": "node scripts/compare-stress-reports.mjs"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.8.0",
    "ibmmq": "^2.1.8",
    "kafkajs": "^2.2.4",
    "mermaid": "^11.15.0",
    "msnodesqlv8": "^5.2.0",
    "mssql": "^11.0.1",
    "node-fetch": "^3.3.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "stompit": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
