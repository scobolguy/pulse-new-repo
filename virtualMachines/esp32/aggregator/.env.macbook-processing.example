# MacBook frontend failover targets (two HAProxy gateways)
VITE_API_BASES=http://192.168.2.101:4100,http://192.168.2.102:4100

# MacBook backend shared broker settings
BROKER_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://192.168.2.50:5672
RABBITMQ_EXCHANGE=pulse-broker
RABBITMQ_QUEUE_PREFIX=pulse
PULSE_QUEUE_PERSISTENCE=1
PULSE_QUEUE_DATA_ROOT=/Users/yourname/pulse-node-data/queue-data
