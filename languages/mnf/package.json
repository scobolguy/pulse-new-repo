{
  "name": "@pulse/mnf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Minnesota FORTRAN (FORTRAN 77, ANSI X3.9-1978) compiler targeting the Pulse p-machine",
  "engines": { "node": ">=22" },
  "exports": {
    ".": "./src/compile-mnf-to-pcode.mjs",
    "./runtime": "./runtime/fortran-library.mjs"
  },
  "scripts": {
    "antlr:generate": "node scripts/generate-parser.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node validation/run.mjs"
  },
  "dependencies": { "antlr4": "^4.13.2" }
}
