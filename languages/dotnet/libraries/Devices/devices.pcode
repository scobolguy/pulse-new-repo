JMP MAIN
DEVICE_OPEN:
FSM OPEN device "{{name}}" "{{type}}" {{pin}}
RET
DEVICE_SETPOWER:
LOAD_NAME ARG0
LOAD_NAME ARG1
JZ POWER_OFF
PUSH_STR "on"
JMP POWER_WRITE
POWER_OFF:
PUSH_STR "off"
POWER_WRITE:
FSM SET power
RET
DEVICE_READPOWER:
LOAD_NAME ARG0
FSM OBSERVE power
RET
DEVICE_SETCOLOR:
LOAD_NAME ARG0
LOAD_NAME ARG1
FSM SET color
RET
DEVICE_READCOLOR:
LOAD_NAME ARG0
FSM OBSERVE color
RET
DEVICE_SETINTENSITY:
LOAD_NAME ARG0
LOAD_NAME ARG1
FSM SET intensity
RET
DEVICE_READINTENSITY:
LOAD_NAME ARG0
FSM OBSERVE intensity
RET
DEVICE_CLOSE:
LOAD_NAME ARG0
FSM CLOSE
RET
DEVICE_DELAY:
LOAD_NAME ARG0
DELAY_MS
RET
MAIN:
HALT
